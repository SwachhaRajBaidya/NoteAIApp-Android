<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/card_friend"
    app:cardElevation="5dp"
    android:layout_marginBottom="30dp"
    app:cardCornerRadius="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/gradient_card">
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/imgRecyclerFriend"
        android:src="@drawable/account_big">
    </ImageView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvRecyclerFirend"
        android:layout_marginLeft="16dp"
        android:layout_gravity="center"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:text="@string/friend_name">
    </TextView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvLatestMessage"
        android:layout_marginLeft="16dp"
        android:layout_gravity="center"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:textStyle="italic"
        android:text="@string/latest_message">
    </TextView>
    </LinearLayout>
</androidx.cardview.widget.CardView>