<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/card_post"
    app:cardElevation="5dp"
    android:layout_marginBottom="30dp"
    app:cardCornerRadius="10dp">

        <LinearLayout
            android:orientation="vertical"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/gradient_card">
        <LinearLayout
             android:orientation="horizontal"
             android:padding="4dp"
             android:layout_width="match_parent"
             android:layout_height="wrap_content">

            <ImageView
                android:layout_width="24sp"
                android:layout_height="24sp"
                android:src="@drawable/calendar"
                android:id="@+id/post_profile">
            </ImageView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heading"
                android:layout_gravity="center"
                android:textSize="20sp"
                android:id="@+id/post_heading"
                android:textStyle="bold"
                android:layout_marginStart="10sp"
                android:textColor="@color/textColor"
                >
            </TextView>



             <TextView
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:text="@string/profile"
                 android:layout_gravity="center"
                 android:textSize="15sp"
                 android:id="@+id/post_username"
                 android:textStyle="bold"
                 android:layout_marginStart="10sp"
                 android:textColor="@color/textColor"
                 >
             </TextView>
        </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp">
            <TextView
                android:id="@+id/post_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_text"
                android:layout_marginTop="4dp"
                android:textSize="20sp"
                android:textColor="@color/textColor"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:id="@+id/post_image"
                android:contentDescription="@string/profile"
                android:src="@drawable/ic_launcher_foreground"
                android:scaleType="centerCrop"/>
            </LinearLayout>
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10sp">

                <ImageButton
                    android:layout_width="20sp"
                    android:layout_height="match_parent"
                    android:id="@+id/btnPostLike"
                    android:contentDescription="@string/profile"
                    android:src="@drawable/heart"
                    android:layout_gravity="center"
                    android:background="@null"
                    android:layout_marginStart="10dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_of_likes"
                    android:gravity="center"
                    android:textColor="@color/textColor"/>

                <ImageButton
                    android:layout_width="20sp"
                    android:layout_height="match_parent"
                    android:id="@+id/btnEdit"
                    android:contentDescription="@string/profile"
                    android:src="@drawable/edit_small"
                    android:layout_gravity="center"
                    android:layout_marginStart="30dp"
                    android:background="@null"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_of_comment"
                    android:gravity="center"
                    android:textColor="@color/textColor"/>

                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="30dp"
                    android:background="@null"
                    android:contentDescription="@string/profile"
                    android:src="@drawable/delete" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_of_share"
                    android:gravity="center"
                    android:textColor="@color/textColor"/>
            </LinearLayout>

            </LinearLayout>
</androidx.cardview.widget.CardView>

